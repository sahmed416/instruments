{
	code: "instrument",
	class: "ItemInstrument",
	maxstacksize: 1,
	storageFlags: 1,

	// Reuses vanilla's own "instrument" item's look (a flute — assets/survival/
	// itemtypes/utility/instrument.json, class ItemFlute) — we only take its
	// shape, not its class/behaviors/animations, since those are tied to
	// ItemFlute's own right-click "call" logic, which this mod doesn't use.
	//
	// The shape file and its two textures are copied verbatim into THIS
	// mod's own assets (shapes/item/tool/instrument/flute1.json,
	// textures/block/coal/coke.png, textures/block/creature/bone/bone1.png)
	// rather than referenced cross-domain via "survival:...". Cross-domain
	// references to those same files (first via an incomplete texture
	// override, then via a "survival" modinfo dependency to fix load order)
	// both still rendered as a missing-asset placeholder cube in-game
	// ("Did not find required shape survival:... anywhere" in
	// client-main.log) for reasons never conclusively pinned down. Bundling
	// the assets locally sidesteps the whole class of cross-domain/
	// load-order questions rather than resolving them — do this for any
	// future vanilla-asset reuse too.
	shape: { base: "item/tool/instrument/flute1" },
	textures: {
		coke: { base: "block/coal/coke" },
		metal: { base: "block/creature/bone/bone1" }
	},
	guiTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: -48, y: 134, z: 171 },
		origin: { x: 0.53, y: 0.2, z: 0.4 },
		scale: 2.8
	},
	tpHandTransform: {
		translation: { x: -0.9, y: -0.05, z: -0.78 },
		rotation: { x: 85, y: 0, z: 2 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 0.68
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 4
	},

	creativeinventory: { "general": ["*"], "items": ["*"], "tools": ["*"] },

	attributes: {
		// Extra entity codes treated as hostile for spawn suppression while
		// an instrument is playing. Anything already declaring
		// group: "hostile" in its own spawnconditions (vanilla drifters,
		// locusts, wolves, bears, ...) is covered automatically and does not
		// need listing here. This is for modded creatures that never set a
		// spawn group. A trailing * matches a prefix.
		extraHostileCodes: [],

		instruments: [
			{ code: "banjo",     sound: "instruments:sounds/instrument/banjo",     volume: 1.0, range: 8 },
			{ code: "harmonica", sound: "instruments:sounds/instrument/harmonica", volume: 1.0, range: 8 },
			{ code: "flute",     sound: "instruments:sounds/instrument/flute",     volume: 1.0, range: 8 },
			{ code: "drums",     sound: "instruments:sounds/instrument/drums",     volume: 1.0, range: 8 },
			{ code: "whistle",   sound: "instruments:sounds/instrument/whistle",   volume: 1.0, range: 8 },
			{ code: "bow",       sound: "instruments:sounds/instrument/bow",       volume: 1.0, range: 8 },
			{ code: "piano",     sound: "instruments:sounds/instrument/piano",     volume: 1.0, range: 8 }
		]
	}
}
